# Alleen voorbeeldnamen. Zet echte waarden nooit in GitHub.
PORT=8787
ALLOWED_ORIGIN=https://svanbergen99.github.io

# Alle vaste Kibana-instellingen komen samen in één JSON-secret.
# Voorbeeldstructuur:
# {"origin":"https://example.invalid","space":"/s/example","dashboardId":"example-id","dashboardVersion":3,"trafficPanelId":"example-panel-id"}
KIBANA_CONFIG=

# Alleen een expliciet goedgekeurde service-authenticatie gebruiken.
# Toegestane vorm: "ApiKey ..." of "Bearer ..."
# Nooit een browsercookie of sid gebruiken.
KIBANA_AUTHORIZATION=
