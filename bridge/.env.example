# Alleen namen van configuratievariabelen. Zet echte waarden nooit in GitHub.
PORT=8787
ALLOWED_ORIGIN=https://svanbergen99.github.io

# Vul onderstaande KIBANA_* waarden uitsluitend in via Codespaces Secrets
# of later via de secret/configuration store van de gekozen host.
KIBANA_ORIGIN=
KIBANA_SPACE=
KIBANA_DASHBOARD_ID=
KIBANA_DASHBOARD_VERSION=
KIBANA_TRAFFIC_PANEL_ID=

# Alleen een expliciet goedgekeurde service-authenticatie gebruiken.
# Toegestane vorm: "ApiKey ..." of "Bearer ..."
# Nooit een browsercookie of sid gebruiken.
KIBANA_AUTHORIZATION=
